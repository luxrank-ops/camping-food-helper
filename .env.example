GEMINI_API_KEY=
# 선택: 이미지 모델 고정 (비우면 gemini-2.5-flash-image → imagen-4.0-generate-001 순으로 시도)
GEMINI_IMAGE_MODEL=
PORT=3000

# 비밀의 정원 Vercel 운영 저장소 (Firebase Admin 서비스 계정 JSON 전체를 한 줄로 입력)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
# Firebase Storage 버킷 이름. 사진 업로드를 쓸 때만 필요 (예: project-id.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=
