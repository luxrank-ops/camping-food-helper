GEMINI_API_KEY=
# 선택: 이미지 모델 고정 (비우면 lib/generate-image.js의 기본 순서대로 시도)
GEMINI_IMAGE_MODEL=
# 선택: 텍스트(JSON) 모델 고정 (비우면 lib/sample.js의 기본 순서대로 시도)
GEMINI_TEXT_MODEL=
PORT=3000

# 비밀의 정원 마스터(관리자) 비밀번호. 운영(Vercel)에서도 마스터 열람/수정/삭제를 쓰려면 설정합니다.
# 비워 두면 마스터 인증 자체가 비활성화됩니다(작성자 비밀번호만 동작). 코드에 넣지 마세요.
MASTER_KEY=

# 비밀의 정원 Vercel 운영 저장소 (Firebase Admin 서비스 계정 JSON 전체를 한 줄로 입력)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
# Firebase Storage 버킷 이름. 사진 업로드를 쓸 때만 필요 (예: project-id.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=
