GEMINI_API_KEY=
# 선택: 이미지 모델 고정 (비우면 lib/generate-image.js의 기본 순서대로 시도)
GEMINI_IMAGE_MODEL=
# 선택: 텍스트(JSON) 모델 고정 (비우면 lib/sample.js의 기본 순서대로 시도)
GEMINI_TEXT_MODEL=
PORT=3000

# 비밀의 정원 마스터(관리자) 비밀번호. 운영(Vercel)에서도 마스터 열람/수정/삭제를 쓰려면 설정합니다.
# 비워 두면 마스터 인증 자체가 비활성화됩니다(작성자 비밀번호만 동작). 코드에 넣지 마세요.
MASTER_KEY=

# 비밀의 정원 Vercel 운영 저장소 (Firebase Admin 서비스 계정 JSON 전체를 한 줄로 입력)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
# Firebase Storage 버킷 이름. 사진 업로드를 쓸 때만 필요 (예: project-id.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=

# ── 회원(로그인) ────────────────────────────────────────────
# 로그인 세션 토큰 서명 키. 비워 두면 FIREBASE_SERVICE_ACCOUNT 에서 유도해 그대로 동작한다.
# 값을 넣으면 서비스 계정 키를 교체해도 로그인이 유지된다(16자 이상 아무 문자열).
AUTH_SECRET=

# ── 유료화(구독 결제) ───────────────────────────────────────
# 비워 두면 결제는 꺼진 상태(업그레이드 버튼이 '준비 중' 안내)로, 무료 플랜만 동작한다.
# lib/billing/provider.js 에 어댑터를 구현한 뒤 아래 값을 채우면 유료화가 켜진다.
BILLING_PROVIDER=
# 예) 토스페이먼츠: TOSS_SECRET_KEY= / TOSS_WEBHOOK_SECRET=
# 예) Stripe: STRIPE_SECRET_KEY= / STRIPE_WEBHOOK_SECRET= / STRIPE_PRICE_PRO=
